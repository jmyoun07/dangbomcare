# =========================================
# 당봄케어 백엔드 — STAGING 환경변수 템플릿 (.env.staging.example)
# 사용법:
#   1) 이 파일을 .env.staging 로 복사
#   2) 아래 값을 '별도 staging Supabase 프로젝트' 기준으로 채움 (운영과 절대 같은 DB 쓰지 말 것!)
#   3) 실행: DANGBOM_ENV=staging 로 백엔드 기동 (run_staging.ps1 참고)
# ⚠️ .env.staging 은 .gitignore 로 커밋 금지. 운영 .env 와 DATABASE_URL/SUPABASE_URL 이 다른지 꼭 확인.
# =========================================

# --- App ---
APP_NAME=DangbomCare-Staging
# staging 으로 두면 production 필수값 검증 게이트는 건너뜀(=로컬 검증 편함). DB 빈값이면 엔진이 에러로 알려줌.
APP_ENV=staging
APP_DEBUG=true
APP_PORT=8001

# --- Supabase (★ 운영과 다른 '별도 프로젝트' 값) ---
SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...staging...
SUPABASE_SERVICE_KEY=eyJhbGc...staging...
SUPABASE_JWT_SECRET=your-staging-jwt-secret

# --- Database (★ staging 프로젝트의 connection string) ---
# 형식: postgresql+asyncpg://postgres.{staging-project-id}:{password}@{host}:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.STAGING_PROJECT_ID:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# --- OpenAI (staging은 비용 아끼려면 mini 통일 권장, 키 없으면 fallback 메시지로 동작) ---
OPENAI_API_KEY=
OPENAI_DAILY_MODEL=gpt-4o-mini
OPENAI_WEEKLY_MODEL=gpt-4o-mini
OPENAI_MONTHLY_MODEL=gpt-4o-mini
DAILY_LIMIT_PER_USER_KRW=50

# --- Firebase (FCM) — staging은 보통 비워둠 ---
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# --- Kakao OAuth — staging은 보통 비워둠 ---
KAKAO_REST_API_KEY=

# --- Sentry — staging은 보통 비워둠 ---
SENTRY_DSN=

# --- CORS (로컬 검증용) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Timezone ---
TIMEZONE=Asia/Seoul
