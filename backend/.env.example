# =========================================
# 당당케어 백엔드 환경변수 (.env.example)
# 실제 .env는 watch/.env에 있음. 이 파일은 템플릿용.
# =========================================

# --- App ---
APP_NAME=DangDangCare
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# --- Supabase ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_KEY=eyJhbGc...
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database ---
# 형식: postgresql+asyncpg://postgres.{project-id}:{password}@{host}:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_ID:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-...
OPENAI_DAILY_MODEL=gpt-4o-mini
OPENAI_WEEKLY_MODEL=gpt-4o
OPENAI_MONTHLY_MODEL=gpt-4o
DAILY_LIMIT_PER_USER_KRW=50

# --- Firebase (FCM) ---
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# --- Kakao OAuth (운영 시) ---
KAKAO_REST_API_KEY=

# --- Sentry ---
SENTRY_DSN=

# --- CORS (개발용) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Timezone ---
TIMEZONE=Asia/Seoul
