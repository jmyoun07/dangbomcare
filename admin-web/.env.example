# Supabase 프로젝트 URL — Dashboard → Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key (공개, 클라이언트 인증용)
# Supabase Dashboard → Project Settings → API → anon public 키 복사
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (서버 전용, 환자 데이터 조회용)
# Supabase Dashboard → Project Settings → API → service_role secret 키 복사
# 절대로 클라이언트에 노출되면 안됨
SUPABASE_SERVICE_ROLE_KEY=
